{
  "name": "butler-ci-cli",
  "version": "3.11.2",
  "description": "CLI para interactuar con Jenkins Pipelines",
  "main": "dist/index.js",
  "bin": {
    "butler-ci-cli": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usarral/butler-ci-cli.git"
  },
  "bugs": {
    "url": "https://github.com/usarral/butler-ci-cli/issues"
  },
  "homepage": "https://github.com/usarral/butler-ci-cli#readme",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "lint": "eslint . --ext .ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run test:run && npm run build"
  },
  "keywords": [
    "jenkins",
    "cli",
    "pipeline",
    "devops",
    "automation"
  ],
  "author": "usarral",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "devDependencies": {
    "@types/inquirer": "9.0.10",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "4.1.12",
    "axios-mock-adapter": "2.1.0",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "axios": "1.21.0",
    "chalk": "5.6.2",
    "commander": "14.0.3",
    "inquirer": "12.11.1",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "zod": "4.6.7"
  }
}
